# Copy to .env and fill in your own credentials.
#
# Blank entries are yours to fill in. Anything that already has a value has a
# working default and can be left alone — those are not shown on the config
# page, so change them here if you need to.


# ---------------------------------------------------------------- Transport
# Which RTC path the avatar comes in on. The classroom behaves identically
# either way; the credentials differ:
#
#   livekit  The conversation runs on this machine. server.py starts the agent
#            worker for you. Models go through LiveKit Inference, so you do not
#            need an account with each provider.
#   agora    Agora Conversational AI Engine hosts ASR/LLM/TTS and the avatar.
#            Models and voice are configured in its console instead of here.
#
# The config page in each client can switch this too.
TRANSPORT=livekit

# ---------------------------------------------------------------- Spatius
# https://app.spatius.ai/apps
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# Which avatar to use; also selectable from the config page. Leave blank for the
# first one (Kian).
#   41c62a7c-993c-4b6b-b6d3-549ce3c8be00  Kian
#   dbb01388-7c57-47bf-ab59-c492caeb9d90  Julian
#   d51ab422-3db7-47cc-afa8-7273b02bc70b  Clara
#   c7069121-8245-4015-9940-82d0dc0c6bda  Halima
# For your own avatars see https://app.spatius.ai/avatars/library
SPATIUS_AVATAR_ID=
# Region. Leave blank to pick the nearest one; set it only if you need to pin a
# specific region.
SPATIUS_REGION=


# ---------------------------------------------------------------- LiveKit
# Needed when TRANSPORT=livekit. https://cloud.livekit.io
# The API secret is shown only once, at creation — copy it there and then.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# ------------------------------------------------------- Models (LiveKit path)
# Routed by LiveKit Inference on LiveKit Cloud, so no per-provider keys needed.
# For the accepted values see STTModels / LLMModels / TTSModels in
# livekit.agents.inference.
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=fishaudio/s2.1-pro

# Synthesis language. Note that the accent comes from the voice, not from this:
# ElevenLabs' default voice reads Chinese with a Cantonese accent, and only
# fishaudio / cartesia give you Mandarin.
TTS_LANGUAGE=zh
# TTS voice. Leave blank for the model's default; see each provider's voice
# library for the accepted values.
TTS_VOICE=


# ---------------------------------------------------------------- Agora
# Needed when TRANSPORT=agora. https://console.agora.io
#
# The certificate has to be enabled for the project in the console
# (Projects → your project → Primary certificate) before it has a value. The
# backend signs tokens with it on the fly, so no Customer ID / Secret needed.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Create an agent under Agents in the console, set its persona and models, hit
# Publish, then copy the pipeline id from the Code panel on the right. The
# models, the voice and the prompt all live in that agent; this only references
# it.
AGORA_PIPELINE_ID=

# The avatar's audio sample rate. It MUST equal the TTS output sample rate of
# the agent above (console → Models → TTS → Sample rate).
#
# ⚠️ The avatar does not resample, and a mismatch is silent on both sides: it
# joins, renders and publishes as usual, the audio track reports `playing`, and
# the volume stays at zero — the picture is fine and nothing is ever said.
# Providers that do not expose the setting (OpenAI, for one) emit 24000, so the
# default is correct there. MiniMax defaults to 32000.
#
# Supported: 8000 / 16000 / 22050 / 24000 / 32000 / 44100 / 48000
AGORA_AVATAR_SAMPLE_RATE=24000

# API endpoint. Leave blank; you normally do not need to change this.
AGORA_CONVOAI_BASE_URL=
